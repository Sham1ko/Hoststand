# Set to true only when the in-memory Mock API should be available in the UI.
# Keep false (or omit the variable) for Vercel deployments that use localStorage.
NEXT_PUBLIC_ENABLE_MOCK_API=false

# Server-only OpenRouter key used by the reservation comment translator.
# Create a key at https://openrouter.ai/settings/keys and never expose it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
